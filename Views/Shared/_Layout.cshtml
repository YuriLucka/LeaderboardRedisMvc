<!DOCTYPE html>
<html lang="pt-br" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LeaderboardRedisMvc</title>
    <link rel="stylesheet" href="~/lib/pico/pico.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="container">
        <header class="app-header">
            <div>
                <span class="eyebrow">Redis · Sorted Set + Cache-Aside</span>
                <h1><a asp-controller="Leaderboard" asp-action="Index" style="color: inherit; text-decoration: none;">Leaderboard</a></h1>
            </div>
            <span class="tech-tag">ASP.NET Core MVC</span>
        </header>

        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
