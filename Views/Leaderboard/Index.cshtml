@model List<LeaderboardRedisMvc.Models.LeaderboardEntry>

@{
    ViewData["Title"] = "Ranking";
}

<form asp-action="AddScore" method="post" class="score-form">
    <div>
        <label for="player">Jogador</label>
        <input type="text" id="player" name="player" placeholder="nome" required />
    </div>
    <div>
        <label for="points">Pontos</label>
        <input type="number" id="points" name="points" step="any" placeholder="0" required />
    </div>
    <button type="submit">Enviar</button>
</form>

@if (Model.Count == 0)
{
    <p><em>Nenhum jogador ainda. Manda a primeira pontuação aí em cima.</em></p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Jogador</th>
                    <th>Pontuação</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="rank-cell">@entry.Rank</td>
                    <td>@entry.Player</td>
                    <td class="num">@entry.Score</td>
                    <td><a asp-action="Player" asp-route-name="@entry.Player" role="button" class="secondary outline">Perfil</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
