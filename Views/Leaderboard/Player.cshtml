@model LeaderboardRedisMvc.Models.PlayerProfile

@{
    ViewData["Title"] = $"Perfil de {Model.Player}";
    bool fromCache = ViewBag.FromCache;
}

<h2>@Model.Player</h2>

@if (fromCache)
{
    <span class="cache-badge hit"><span class="dot"></span> veio do cache — calculado @Model.ComputedAt.ToLocalTime().ToString("HH:mm:ss")</span>
}
else
{
    <span class="cache-badge miss"><span class="dot"></span> calculado agora (~1.5s) e guardado no cache por 30s</span>
}

<div class="stat-grid">
    <div class="stat">
        <span class="label">Posição</span>
        <span class="value num">#@Model.Rank</span>
    </div>
    <div class="stat">
        <span class="label">Pontuação</span>
        <span class="value num">@Model.Score</span>
    </div>
    <div class="stat">
        <span class="label">Partidas</span>
        <span class="value num">@Model.MatchesPlayed</span>
    </div>
    <div class="stat">
        <span class="label">Vitórias</span>
        <span class="value num">@Model.WinRate%</span>
    </div>
</div>

<p>
    <a asp-action="Index" role="button" class="secondary outline">← Ranking</a>
</p>
<p><small>Recarregue em menos de 30s pra ver "veio do cache"; espere mais e veja recalcular.</small></p>
